# Copy to .env (never commit .env). DEVELOPMENT values only.
AGENTGUARD_ENV=development
AGENTGUARD_PG_HOST=127.0.0.1
AGENTGUARD_PG_PORT=5432
AGENTGUARD_PG_DB=agentguard
AGENTGUARD_PG_USER=agentguard
AGENTGUARD_PG_PASSWORD=change-me-dev-only
AGENTGUARD_PG_SSLMODE=disable
# Production: AGENTGUARD_ENV=production, AGENTGUARD_PG_SSLMODE=verify-full, AGENTGUARD_PG_SSLROOTCERT=/etc/pg/ca.pem,
# AGENTGUARD_PG_PASSWORD_FILE=/run/secrets/pg_password (instead of AGENTGUARD_PG_PASSWORD)
# Key-store master key (Fernet, 32 url-safe base64 bytes): generate with
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
AGENT_IDENTITY_MASTER_KEY=
