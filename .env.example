# ── Core ─────────────────────────────────────────────────────────────────────
APP_ENV=production
CORS_ORIGINS=http://localhost:3000
AUTH_ENABLED=true

# ── Tool security (read docs/SECURITY_AND_LIMITATIONS.md) ────────────────────
# local      = static allow-list (works out of the box)
# agentguard = ask AgentGuard before every tool call (needs AGENTGUARD_CLIENT_FACTORY, see HOSTING.md)
TOOL_GATE_MODE=local
TOOL_ALLOWLIST=echo,now,web_search,file_generator
TOOL_DENYLIST=
# disabled (default) | isolated (needs a host with a working jail backend)
PYTHON_EXEC_MODE=disabled
AGENTGUARD_URL=http://agentguard:8443
AGENTGUARD_CLIENT_FACTORY=
AGENTGUARD_AGENT_ID=aql-1

# ── LLM gateways ─────────────────────────────────────────────────────────────
UNOROUTER_API_KEY=
EXPERIMENTLAB_API_KEY=

# ── Supabase / Pinecone ──────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PINECONE_API_KEY=

# ── Billing (manual Payoneer flow) ───────────────────────────────────────────
PAYONEER_EMAIL=
ADMIN_TOKEN=            # long random string; required for payment approval endpoints

# ── Frontend build args ──────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_PAYONEER_PAYMENT_URL=
