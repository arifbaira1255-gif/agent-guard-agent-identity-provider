# ── AQL-1 Backend Environment ───────────────────────────────────────────────
# Copy to `.env` and fill in real values. NEVER commit `.env`.

# App
APP_NAME=AQL-1
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# ── LLM Providers (OpenAI-compatible gateways only) ─────────────────────────
# UnoRouter is the PRIMARY backend; ExperimentLab is the fallback. No direct
# OpenAI / Anthropic accounts are used. With no keys the router degrades to a
# local stub so the app still boots.
UNOROUTER_API_KEY=your-unorouter-key
UNOROUTER_BASE_URL=https://api.unorouter.com/v1
UNOROUTER_MODEL=claude-opus-4.6
EXPERIMENTLAB_API_KEY=your-experimentlab-key
EXPERIMENTLAB_BASE_URL=https://api.experimentlab.ai/v1
# Leave empty to reuse UNOROUTER_MODEL; otherwise a model ExperimentLab serves.
EXPERIMENTLAB_MODEL=

# ── Vector DB (Pinecone) ────────────────────────────────────────────────────
PINECONE_API_KEY=your-pinecone-key
# Integrated-embedding index: Pinecone embeds the text itself (upsert_records).
PINECONE_INDEX_NAME=llama-text-embed-v2-index
PINECONE_NAMESPACE=default
PINECONE_ENVIRONMENT=us-east-1

# ── Supabase (state / auth / storage) ───────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ── Billing: manual Payoneer / bank-transfer verification ─────────────────────
# Users pay to PAYONEER_EMAIL (or the bank details), then submit a transaction
# ID + screenshot. An admin approves it (X-Admin-Token) to activate the plan.
PAYONEER_EMAIL=your-payoneer-email@example.com
PAYONEER_MERCHANT_ID=
PAYONEER_API_KEY=
PAYONEER_PAYMENT_URL=
BANK_TRANSFER_DETAILS=Bank name / Account holder / IBAN or account no. / SWIFT
# Long random string guarding the admin approval endpoints. REQUIRED for approvals.
ADMIN_TOKEN=change-me-to-a-long-random-string
BILLING_ENABLED=true
PAYMENT_PERIOD_DAYS=30
SUBSCRIPTIONS_TABLE=subscriptions
USAGE_TABLE=usage
PAYMENT_VERIFICATIONS_TABLE=payment_verifications
PAYMENT_SCREENSHOT_BUCKET=payment-screenshots

# ── Agent runtime ───────────────────────────────────────────────────────────
AGENT_MAX_STEPS=12
AGENT_TIMEOUT_SECONDS=120

# ── Safety guardrails / human-in-the-loop approval ───────────────────────────
# When enabled, high-risk actions (email/message send, DB delete, financial
# actions, shell exec, file delete, credential access, bulk export) PAUSE the
# run and wait for a human decision via POST /agent/approve.
GUARDRAILS_ENABLED=true
GUARDRAILS_APPROVAL_TABLE=pending_approvals
# Set true only for local demos — skips the human gate entirely.
GUARDRAILS_AUTO_APPROVE=false

# ── REST API authentication (hashed API keys + rate limiting) ─────────────────
# Keys are stored SHA-256 hashed in the `api_keys` Supabase table — never in
# plaintext. Clients send them as `Authorization: Bearer <key>` or `X-API-Key`.
# Set AUTH_ENABLED=false to disable the middleware entirely in local dev.
AUTH_ENABLED=true
API_KEYS_TABLE=api_keys
# Prefix applied to freshly minted keys (helps secret scanners spot them).
API_KEY_PREFIX=aql1_
# Per-key rate limit: N requests per rolling window of M seconds.
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
# Comma-separated routes that never require a key.
AUTH_PUBLIC_PATHS=/health,/docs,/redoc,/openapi.json,/docs/oauth2-redirect,/v1/billing/,/
