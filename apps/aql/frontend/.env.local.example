# Frontend environment — copy to `.env.local`
# Render backend URL (no trailing slash). NEXT_PUBLIC_API_URL is also accepted.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Optional: shown as a "Pay now" button if you later get a Payoneer payment link.
NEXT_PUBLIC_PAYONEER_PAYMENT_URL=
